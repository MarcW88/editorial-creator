{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "content", "skillExecution", "contextConflicts"],
  "properties": {
    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "REVISION_REQUIRED"]},
    "summary": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "skillExecution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "filesConsulted", "actions", "tools", "status", "justification"],
        "properties": {
          "skill": {"type": "string"},
          "filesConsulted": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}},
          "tools": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
          "justification": {"type": "string", "minLength": 1}
        }
      }
    },
    "contextConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "source", "foreignRule", "resolution"],
        "properties": {
          "skill": {"type": "string"},
          "source": {"type": "string"},
          "foreignRule": {"type": "string"},
          "resolution": {"type": "string"}
        }
      }
    }
  }
}
